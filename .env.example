# Sensitive credentials (do not commit to Git)
# Structural settings are in config.yaml

# === Qdrant ===
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# === LLM ===
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.0-flash-exp
# LLM_BASE_URL=                          # Leave empty for Gemini direct
# LLM_BASE_URL=https://openrouter.ai/api/v1  # Uncomment for OpenRouter

# === JIRA (required if story_source: jira in config.yaml) ===
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-api-token